# ============================================================
#  CivicSense Backend — Environment Variables Template
#  INSTRUCTIONS:
#    1. Copy this file:   copy .env.example .env
#    2. Fill in your own values below
#    3. NEVER commit your actual .env to source control
# ============================================================

# -----------------------------------------------
# SERVER CONFIG
# -----------------------------------------------

# Port the Express server will listen on
PORT=5000

# MongoDB connection string
# Local dev:   mongodb://localhost:27017/civicsense
# Atlas cloud: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/civicsense
MONGO_URI=mongodb://localhost:27017/civicsense

# Node environment: development | production
NODE_ENV=development


# -----------------------------------------------
# AUTHENTICATION (REQUIRED)
# -----------------------------------------------

# JWT signing secret — MUST be changed before production
# Generate a secure one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_256_BIT_RANDOM_STRING


# -----------------------------------------------
# CLOUDINARY — Image/Media Storage (REQUIRED)
# -----------------------------------------------

# Create a free account at: https://cloudinary.com
# Find these in Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# -----------------------------------------------
# EMAIL / OTP — Password Reset Flow (OPTIONAL)
# -----------------------------------------------

# If left empty, OTPs will be printed to the server console instead of emailed
# This is fine for development — set for production

# Use a Gmail account with an App Password (not your real password)
# Enable App Passwords at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password


# -----------------------------------------------
# GOOGLE OAUTH — Social Login (OPTIONAL)
# -----------------------------------------------

# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (add this): http://localhost:5000/api/users/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# -----------------------------------------------
# GITHUB OAUTH — Social Login for Authority (OPTIONAL)
# -----------------------------------------------

# Create a GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:5000/api/users/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret


# -----------------------------------------------
# GOOGLE GEMINI AI — Image Verification (OPTIONAL)
# -----------------------------------------------

# Get a free key at: https://aistudio.google.com/app/apikey
# If left empty, the system uses keyword-based priority simulation as fallback
# The system NEVER fails due to a missing AI key
GEMINI_API_KEY=your_gemini_api_key


# -----------------------------------------------
# GOOGLE MAPS (RESERVED — NOT CURRENTLY USED)
# -----------------------------------------------

# Reserved for future Google Maps Geocoding integration
# Currently using OpenStreetMap Nominatim (free, no key needed)
GOOGLE_MAPS_API_KEY=


# -----------------------------------------------
# NOTES ON OPTIONAL VARIABLES
# -----------------------------------------------
#
# | Variable          | Missing Behaviour                              |
# |:------------------|:-----------------------------------------------|
# | EMAIL_USER/PASS   | OTP printed to console, email not sent         |
# | GOOGLE_CLIENT_ID  | Google OAuth button disabled                   |
# | GITHUB_CLIENT_ID  | GitHub OAuth button disabled                   |
# | GEMINI_API_KEY    | Keyword-based simulation used instead          |
# | GOOGLE_MAPS_KEY   | Not used — Nominatim handles geocoding for free|
#
# The system is designed to run with ONLY these required:
#   PORT, MONGO_URI, NODE_ENV, JWT_SECRET,
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
#
# ============================================================
